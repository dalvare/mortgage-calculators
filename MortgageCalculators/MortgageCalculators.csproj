<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>

        <PackageId>MortgageCalculators</PackageId>
        <PackageVersion>1.2.0</PackageVersion>
        <Authors>Dan Alvare</Authors>
        <Company>JerseyDev</Company>
        <Product>Mortgage Calculators</Product>
        <Description>A collection of C# mortgage calculators</Description>
        <PackageProjectUrl>https://github.com/dalvare/mortgage-calculators</PackageProjectUrl>
        <RepositoryUrl>https://github.com/dalvare/mortgage-calculators</RepositoryUrl>
        <RepositoryType>git</RepositoryType>
        <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
        <PackageReadmeFile>README.md</PackageReadmeFile>
        <PackageTags>mortgage;calculator;affordability;loan;comparison;refinance;finance;real-estate</PackageTags>
        <PackageReleaseNotes>Affordability requests that cannot fund a loan are rejected by validation instead of failing or returning negative figures, and affordability figures are rounded to the nearest hundred with the payment, PMI, and schedule derived from that loan. Refinance results respect the holding period and report closing costs on the refinance loan. Loan comparison validates each home value against the loan amount. Amortization schedules reconcile to the cent and all response figures are rounded. Shared math supports non-monthly payment and compounding frequencies and guards its zero and overflow paths.</PackageReleaseNotes>

        <GenerateDocumentationFile>true</GenerateDocumentationFile>
        <DocumentationFile>bin\$(Configuration)\$(TargetFramework)\$(AssemblyName).xml</DocumentationFile>
        <RootNamespace>MortgageCalculators</RootNamespace>
    </PropertyGroup>
    <ItemGroup>
        <None Include="..\README.md" Pack="true" PackagePath="" />
    </ItemGroup>
    <ItemGroup>
        <PackageReference Include="FluentValidation" Version="11.11.0" />
        <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="8.0.1" />
    </ItemGroup>
</Project>
